<?xml version="1.0"?>
<package format="3">
  <name>wheelloong_auto_sdk</name>
  <version>0.1.0</version>
  <description>Stable Python task SDK for Wheelloong/Shiloong AUTO-mode robot capabilities.</description>
  <maintainer email="zeropanga@buaa.com">zeropanga</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>arm_common</exec_depend>
  <exec_depend>system_common</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>voice_common</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
