{
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "python.languageServer": "Pylance",
  "python.analysis.indexing": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.useLibraryCodeForTypes": true,
  "python.analysis.include": [
    "${workspaceFolder}/src/wheelloong_auto_sdk/wheelloong_auto_sdk",
    "${workspaceFolder}/src/wheelloong_auto_sdk/examples",
    "${workspaceFolder}/src/wheelloong_auto_sdk/test"
  ],
  "python.analysis.exclude": [
    "${workspaceFolder}/build/**",
    "${workspaceFolder}/install/**",
    "${workspaceFolder}/log/**"
  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}/src/wheelloong_auto_sdk",
    "/home/niic/auto_sdk_ws/build/wheelloong_auto_sdk",
    "/home/niic/auto_sdk_ws/install/wheelloong_auto_sdk/lib/python3.10/site-packages",
    "/home/niic/wheelloong/install/arm_common/local/lib/python3.10/dist-packages",
    "/home/niic/wheelloong/install/system_common/local/lib/python3.10/dist-packages",
    "/home/niic/wheelloong/install/voice_common/local/lib/python3.10/dist-packages",
    "/home/niic/wheelloong/install/utils_common/local/lib/python3.10/dist-packages",
    "/home/niic/wheelloong/install/nav2_msgs/local/lib/python3.10/dist-packages",
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/opt/ros/humble/local/lib/python3.10/dist-packages"
  ],
  "python.envFile": "${workspaceFolder}/.vscode/python.env",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/src/wheelloong_auto_sdk",
  "python.testing.pytestArgs": [
    "test"
  ],
  "terminal.integrated.profiles.linux": {
    "Wheelloong ROS Bash": {
      "path": "/bin/bash",
      "args": [
        "--init-file",
        "${workspaceFolder}/.vscode/ros_bashrc"
      ]
    }
  },
  "terminal.integrated.defaultProfile.linux": "Wheelloong ROS Bash",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".pytest_cache": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    ".pytest_cache": true
  }
}
